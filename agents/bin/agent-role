#!/usr/bin/env bash
# agent-role: start Pi role agents in herdr panes, give them tasks, and stop
# them.
#
# Usage:
#   agent-role ROLE [--chat] [--focus] [--preset PRESET [--force]] [--name NAME]
#              [--pane right|side|PANE_ID] [--cwd DIR] [--session ID] [--dry-run]
#   agent-role --prompt NAME [OPTION...] <<'TASK'
#   agent-role --set-model NAME PRESET [--force]
#   agent-role --restart NAME [--preset PRESET] [--force]
#   agent-role --models
#   agent-role --stop NAME [NAME...]
#   agent-role --snapshot [DIR]
#
# ROLE is a file in the roles directory (dev, reviewer, qa, pm).
# --pane right    split right of the calling pane (default for dev)
# --pane side     use the side column on the right of the tab (default for pm,
#                 qa, reviewer). The first side agent makes the column.
# --pane PANE_ID  use an existing pane that is at a shell prompt
# --preset PRESET use this preset, not the preset of the role. PRESET is a
#                 name in the config, or a model as provider/id.
# --force         allow --preset for a role in the "pinned" list of the config.
#                 Without --preset, AGENT_ROLES_PRESET gives the preset of each
#                 role that is not pinned.
# --session ID    continue the role session ID in DIR (see --restart).
# --chat          chat mode: a person talks with the agent. The prompt has no
#                 orchestrator and no STATUS: line. A restart keeps chat mode.
# --focus         after a successful start, focus the new pane. Without it the
#                 focus stays where it is, so an orchestrator does not take
#                 your focus.
# Start prints JSON: {"name", "role", "pane", "preset", "model"}.
#
# --prompt NAME   read a task from stdin and give it to the agent with
#                 `herdr agent prompt`. Each OPTION (for example --wait
#                 --timeout 300000) goes to herdr. The task is not given to a
#                 shell, so backticks and $(...) in it stay text.
# --set-model NAME PRESET
#                 switch a running agent to the model of PRESET with the Pi
#                 command /model. The session and its history stay. Prints
#                 {"name", "preset", "model"}. An agent that has had no task
#                 yet starts again (as --restart does).
# --restart NAME  stop the agent and start it again in a new pane, on the
#                 same session. With --preset, on that model. Use it when the
#                 agent is stuck or /model is not enough.
# --models        print one JSON line for each role agent of this tab: the
#                 model that the agent uses, the model that gave the last
#                 reply (a router shows the real model here), and the model
#                 family. The last line is the orchestrator in the calling
#                 pane, if herdr knows its session. A warning tells when the
#                 reviewer has the family of dev or of the orchestrator.
# --stop NAME...  stop each agent and close its pane. When the last side pane
#                 closes, the side column goes away. An agent that is not
#                 there (for example, its pane was closed by hand) is not an
#                 error.
# --snapshot DIR  print a git tree id of the files in the work tree of DIR
#                 (default: .): tracked and untracked files, not ignored
#                 files. Equal ids mean that no file changed. The git index
#                 does not change.
#
# Environment:
#   AGENT_ROLES_CONFIG  machine config (default ~/.config/agent-roles/config.json)
#   AGENT_ROLES_DIR     role files (default: ../roles next to this script)
#   AGENT_ROLES_PRESET  preset for roles that are not pinned, when no --preset
#   AGENT_ROLES_PI_DIR  Pi agent dir of role agents
#                       (default ~/.local/state/agent-roles/pi-agent)
#
# Role agents do not use your Pi agent dir (~/.pi/agent). They use their own,
# so Pi does not find your extensions, packages, skills and prompts there.
# From outside the project, only the config extensions load, and the
# extensions that your Pi install itself adds to each agent dir. A project
# that you trust can add its own. Before each start, agent-role links
# auth.json, models.json, keybindings.json, trust.json and AGENTS.md from your
# dir, and copies the display settings and the thinking level. Role sessions
# are in the role dir, so /resume in your own Pi does not show them.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
roles_dir=${AGENT_ROLES_DIR:-$here/../roles}
config=${AGENT_ROLES_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-roles/config.json}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/agent-roles
agent_dir=${AGENT_ROLES_PI_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-roles/pi-agent}
user_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
[[ $user_dir != "$agent_dir" ]] || user_dir=$HOME/.pi/agent
# One JSON file for each running role agent: role, preset, model, session.
meta=$agent_dir/role-agents
self=${HERDR_PANE_ID:-}
tab=${HERDR_TAB_ID:-}

die() { echo "agent-role: $*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "${BASH_SOURCE[0]}"; exit "${1:-0}"; }

command -v herdr >/dev/null || die "herdr not found"
command -v jq >/dev/null || die "jq not found"

# Prints {"stopped", "closed_pane"}, or {"stopped", "note"} if the agent is
# not there. Any other herdr error stops the script.
stop_agent() {
  local name=$1 out pane
  if ! out=$(herdr agent get "$name" 2>&1); then
    [[ $(jq -r '.error.code? // empty' <<<"$out" 2>/dev/null) == agent_not_found ]] ||
      die "cannot stop $name: $out"
    rm -f "$meta/$name.json"
    jq -nc --arg name "$name" '{stopped: $name, note: "no such agent, nothing to stop"}'
    return 0
  fi
  pane=$(jq -er '.result.agent.pane_id' <<<"$out") || die "no pane for agent: $name"
  herdr pane close "$pane" >/dev/null
  rm -f "$meta/$name.json"
  jq -nc --arg name "$name" --arg pane "$pane" '{stopped: $name, closed_pane: $pane}'
}

# Give the task on stdin to the agent. The task goes to herdr as one argument,
# and no shell reads it.
prompt_agent() { # name [herdr option...]
  local name=$1 task
  shift
  [[ ! -t 0 ]] || die "give the task on stdin: agent-role --prompt $name <<'TASK'"
  task=$(cat)
  [[ -n ${task//[[:space:]]/} ]] || die "the task for $name is empty"
  exec herdr agent prompt "$name" "$task" "$@"
}

# Print a git tree id of the work tree. git adds all files to a copy of the
# index, so the real index and other git commands are not affected. The blobs
# that git writes are removed later by git gc.
snapshot() { # [dir]
  local top index
  top=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null) ||
    die "not a git work tree: ${1:-.}"
  index=$(git -C "$top" rev-parse --git-path index)
  [[ $index == /* ]] || index=$top/$index
  tmp_index=$(mktemp "${TMPDIR:-/tmp}/agent-role-index.XXXXXX")
  trap 'rm -f "$tmp_index"' EXIT
  # git cannot read an empty index file. With no index, git makes a new one.
  if [[ -f $index ]]; then cp "$index" "$tmp_index"; else rm -f "$tmp_index"; fi
  GIT_INDEX_FILE=$tmp_index git -C "$top" add -A
  GIT_INDEX_FILE=$tmp_index git -C "$top" write-tree
}

# Frontmatter value for key $1, or empty.
fm() { awk -v k="$1" 'NR==1 && /^---$/ {f=1; next} f && /^---$/ {exit}
  f && index($0, k ":") == 1 {sub("^" k ":[ \t]*", ""); print; exit}' "$file"; }
# Role body without frontmatter.
body() { awk 'NR==1 && /^---$/ {f=1; next} f==1 && /^---$/ {f=2; next} f!=1' "$file"; }

need_herdr() {
  [[ ${HERDR_ENV:-} == 1 && -n $self && -n $tab ]] || die "run this inside a herdr pane"
}

# The model of a preset: a name in the config, or provider/id as it is.
resolve_model() {
  [[ -f $config ]] || die "no config: $config (run agents/install.sh)"
  if [[ $1 == */* ]]; then printf '%s\n' "$1"; return; fi
  jq -er --arg p "$1" '.presets[$p] // empty' "$config" ||
    die "preset '$1' is not in $config"
}

# A model without a thinking level at the end (provider/id:high).
bare_model() {
  case ${1##*:} in
    off | minimal | low | medium | high | xhigh | max) printf '%s\n' "${1%:*}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The -e options for the extensions of the config, in the global exts.
load_exts() {
  local e
  exts=()
  while IFS= read -r e; do
    [[ -n $e ]] && exts+=(-e "${e/#\~/$HOME}")
  done < <(jq -r '(.extensions // [])[]' "$config")
}

# Stop unless Pi can use the model. Pi lists only the models that it has a
# key for. A role agent that cannot get its model does not start, and /model
# opens a model list that waits for a person. Ask the Pi of the role agent:
# the same agent dir, extensions and cwd (a provider can come from each).
check_model() { # model cwd
  local m out
  m=$(bare_model "$1")
  load_exts
  out=$(cd "$2" && PI_CODING_AGENT_DIR=$agent_dir pi ${exts[@]+"${exts[@]}"} \
    --list-models "${m#*/}" 2>/dev/null || true)
  awk -v p="${m%%/*}" -v m="${m#*/}" '$1 == p && $2 == m {f = 1} END {exit !f}' <<<"$out" ||
    die "Pi cannot use the model $m (see: pi --list-models)"
}

# True when the role is in the "pinned" list of the config.
pinned() {
  jq -e --arg r "$1" '(.pinned // []) | index($r) != null' "$config" >/dev/null
}

# Stop when the role keeps its preset, unless --force was given.
check_pin() {
  ((force)) && return
  if pinned "$1"; then
    die "$1 keeps its preset (\"pinned\" in $config). Add --force to change it."
  fi
}

# The model family, from the model name. Empty when it is not known, for
# example for a router. Then the model of the last reply tells the family.
family() {
  case $(tr '[:upper:]' '[:lower:]' <<<"$1") in
    *claude*) echo anthropic ;;
    *gpt* | */o[0-9]*) echo openai ;;
    *gemini* | *gemma*) echo google ;;
    *deepseek*) echo deepseek ;;
    *glm*) echo zhipu ;;
    *kimi*) echo moonshot ;;
    *qwen*) echo qwen ;;
    *llama*) echo meta ;;
    *mistral* | *devstral* | *codestral*) echo mistral ;;
    *grok*) echo xai ;;
  esac
}

# The file of a role session. Pi writes it after the first reply.
session_file() {
  find "$agent_dir/sessions" -name "*_$1.jsonl" -print -quit 2>/dev/null || true
}

# One JSON line for each role agent of this tab that herdr knows. A state
# file of an agent that is gone is removed.
tab_models() {
  local st name f fam
  for st in "$meta"/*.json; do
    [[ -e $st ]] || continue
    [[ $(jq -r .tab "$st") == "$tab" ]] || continue
    name=$(jq -r .name "$st")
    herdr agent get "$name" >/dev/null 2>&1 || { rm -f "$st"; continue; }
    f=$(session_file "$(jq -r .session "$st")")
    jq -s -c --slurpfile st "$st" '$st[0] as $a
      | ([.[($a.skip // 0):][] | select(.type == "model_change")] | last) as $c
      | ([.[] | select(.type == "message" and .message.role == "assistant")]
        | last | .message) as $r
      | {name: $a.name, role: $a.role, preset: $a.preset,
        model: (if $c then "\($c.provider)/\($c.modelId)" else $a.model end),
        reply: (if $r then "\($r.provider)/\($r.responseModel // $r.model)"
          else null end)}' "${f:-/dev/null}" |
      while IFS= read -r line; do
        fam=$(family "$(jq -r .model <<<"$line")")
        [[ -n $fam ]] || fam=$(family "$(jq -r '.reply // ""' <<<"$line")")
        jq -c --arg f "$fam" '. + {family: (if $f == "" then null else $f end)}' <<<"$line"
      done
  done
  orchestrator_model
}

# One JSON line for the agent in the calling pane (the orchestrator), with the
# model of its last reply. Pi and Claude Code both keep it in .message of the
# session file that herdr knows. Nothing when herdr does not know a file.
orchestrator_model() {
  local a f m fam
  a=$(herdr agent list 2>/dev/null |
    jq -c --arg p "$self" '.result.agents[]? | select(.pane_id == $p)' 2>/dev/null |
    head -n 1 || true)
  [[ -n $a ]] || return 0
  f=$(jq -r 'select(.agent_session.kind == "path") | .agent_session.value // empty' <<<"$a")
  [[ -n $f && -f $f ]] || return 0
  # The model is the last model change (Pi). A reply whose request started
  # after it names the model instead: Pi does not record a --model on resume.
  # A reply that started before the change (it was in flight) does not count.
  # Claude Code has no model changes: its last reply names the model. `reply`
  # is the model that gave the last reply (for a router, the real model).
  m=$(tail -n 200 "$f" | jq -sc '
    def ms: if type == "number" then .
      elif type == "string" then
        (capture("^(?<s>[^.]*)(\\.(?<f>[0-9]+))?Z$")
          | ((.s + "Z") | fromdate) * 1000 + ((.f // "0")[0:3] | tonumber))? // 0
      else 0 end;
    def reply: .type == "assistant" or (.type == "message" and .message.role == "assistant");
    ([.[] | select(.type == "model_change")] | last
      | if . then {conf: "\(.provider)/\(.modelId)", t: (.timestamp | ms)} else null end) as $c
    | ([.[] | select(reply)] | last | if . then {
        conf: ((if .message.provider then "\(.message.provider)/" else "" end) + .message.model),
        real: (.message.responseModel // .message.model),
        t: ((.message.timestamp // .timestamp) | ms)} else null end) as $r
    | (if $c and ($r == null or $r.t <= $c.t) then $c.conf
      elif $r then $r.conf else null end) as $m
    | select($m != null) | {model: $m, reply: (if $r then $r.real else null end)}' \
    2>/dev/null || true)
  [[ -n $m ]] || return 0
  fam=$(family "$(jq -r .model <<<"$m")")
  [[ -n $fam ]] || fam=$(family "$(jq -r '.reply // ""' <<<"$m")")
  jq -c --arg n "$(jq -r '.name // "orchestrator"' <<<"$a")" --arg f "$fam" \
    '{name: $n, role: "orchestrator", model, reply,
      family: (if $f == "" then null else $f end)}' <<<"$m"
}

# Warn when the reviewer has the model family of the agents that make the
# work: dev and the orchestrator. qa and pm can share its family.
warn_families() {
  jq -rs '(map(select(.role == "reviewer" and .family != null))) as $rev
    | $rev[] as $r | .[]
    | select((.role == "dev" or .role == "orchestrator") and .family == $r.family)
    | "agent-role: warning: \($r.name) and \(.name) both use \(.family) models. The reviewer should use another family."' >&2
}

# Switch a running agent to another model with the Pi command /model.
set_model() { # name preset
  local name=$1 st=$meta/$1.json role model m i f n0
  need_herdr
  [[ -f $st ]] || die "no role agent $name (agent-role --models lists them)"
  herdr agent get "$name" >/dev/null 2>&1 || die "agent $name is not running"
  role=$(jq -r .role "$st")
  model=$(resolve_model "$2")
  file=$roles_dir/$role.md
  [[ -f $file && $2 == "$(fm preset)" ]] || check_pin "$role"
  check_model "$model" "$(jq -r .cwd "$st")"
  m=$(bare_model "$model")
  # Pi writes the session file when the agent gets its first task. With no
  # file, the agent has no context to keep, and Pi gives no proof of a switch
  # (the pane status can show the same line again). Start it again instead.
  f=$(session_file "$(jq -r .session "$st")")
  if [[ -z $f ]]; then
    echo "agent-role: note: $name has had no task yet. It starts again on $2." >&2
    if ((force)); then restart "$name" --preset "$2" --force; fi
    restart "$name" --preset "$2"
  fi
  # The proof of the switch: a new model change to provider/id in the session.
  n0=$(model_changes "$f")
  # Pi runs /model at once, also while the agent works.
  herdr agent prompt "$name" "/model $m" >/dev/null
  # Pi can take 15 s to refresh its model lists before it switches. Wait 20 s
  # (AGENT_ROLES_SWITCH_TRIES times 0.2 s; the tests make it short).
  local tries=${AGENT_ROLES_SWITCH_TRIES:-100}
  for ((i = 1; ; i++)); do
    (($(model_changes "$f") > n0)) && [[ $(last_model_change "$f") == "$m" ]] && break
    ((i < tries)) || die "$name did not switch to $m in $((tries / 5)) s. Read its pane: a model list can wait for input. Or run: agent-role --restart $name --preset $2"
    sleep 0.2
  done
  # /model does not take a thinking level. Give it with /thinking.
  [[ $m == "$model" ]] || herdr agent prompt "$name" "/thinking ${model##*:}" >/dev/null
  jq --arg p "$2" --arg m "$model" '.preset = $p | .model = $m' "$st" >"$st.tmp"
  mv "$st.tmp" "$st"
  {
    jq -nc --arg n "$name" --arg p "$2" --arg m "$model" '{name: $n, preset: $p, model: $m}'
    tab_models | warn_families
  }
}

# The number of model changes in a session file, and the last one.
model_changes() {
  [[ -n $1 ]] || { echo 0; return; }
  jq -s '[.[] | select(.type == "model_change")] | length' "$1" 2>/dev/null || echo 0
}
last_model_change() {
  jq -rs '[.[] | select(.type == "model_change")] | last
    | "\(.provider)/\(.modelId)"' "$1" 2>/dev/null || true
}


# Stop an agent and start it again in a new pane on the same session.
restart() { # name [start option...]
  local name=$1 st=$meta/$1.json role preset want="" saved
  need_herdr
  [[ -f $st ]] || die "no role agent $name (agent-role --models lists them)"
  shift
  saved=$(cat "$st")
  role=$(jq -r .role <<<"$saved")
  preset=$(jq -r .preset <<<"$saved")
  while (($#)); do
    case $1 in
      --preset) [[ $# -ge 2 ]] || usage 1; want=$2; shift 2 ;;
      --force) force=1; shift ;;
      *) die "--restart takes only --preset and --force" ;;
    esac
  done
  # Check the new model before the old agent stops.
  if [[ -n $want ]]; then
    file=$roles_dir/$role.md
    [[ $want == "$preset" || $want == "$(fm preset)" ]] || check_pin "$role"
    preset=$want
  fi
  check_model "$(resolve_model "$preset")" "$(jq -r .cwd <<<"$saved")"
  stop_agent "$name" >/dev/null
  exec "${BASH_SOURCE[0]}" "$role" --name "$name" --pane "$(jq -r .where <<<"$saved")" \
    $(jq -r 'if .chat then "--chat" else empty end' <<<"$saved") \
    --cwd "$(jq -r .cwd <<<"$saved")" --session "$(jq -r .session <<<"$saved")" \
    --preset "$preset" --force
}

role="" name="" where="" cwd=$PWD dry=0 preset_opt="" force=0 session="" chat=0 focus=0
while (($#)); do
  case $1 in
    -h | --help) usage ;;
    --stop)
      [[ $# -ge 2 ]] || usage 1
      shift
      for n in "$@"; do stop_agent "$n"; done
      exit ;;
    --prompt)
      [[ $# -ge 2 ]] || usage 1
      shift
      prompt_agent "$@" ;;
    --snapshot)
      [[ $# -le 2 ]] || usage 1
      snapshot "${2:-.}"
      exit ;;
    --set-model)
      [[ $# -ge 3 ]] || usage 1
      [[ ${4:-} == --force ]] && force=1
      set_model "$2" "$3"
      exit ;;
    --restart)
      [[ $# -ge 2 ]] || usage 1
      shift
      restart "$@" ;;
    --models)
      need_herdr
      out=$(tab_models)
      [[ -z $out ]] || printf '%s\n' "$out"
      warn_families <<<"$out"
      exit ;;
    --preset) preset_opt=$2; shift 2 ;;
    --force) force=1; shift ;;
    --session) session=$2; shift 2 ;;
    --name) name=$2; shift 2 ;;
    --pane) where=$2; shift 2 ;;
    --cwd) cwd=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --chat) chat=1; shift ;;
    --focus) focus=1; shift ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z $role ]] || die "give one role only"; role=$1; shift ;;
  esac
done
[[ -n $role ]] || usage 1
cwd=$(cd "$cwd" && pwd) || die "no such directory: $cwd"

file=$roles_dir/$role.md
[[ -f $file ]] || die "no role file: $file"
[[ -f $config ]] || die "no config: $config (run agents/install.sh)"

preset=$(fm preset)
[[ -n $preset ]] || die "$role.md has no preset"
if [[ -z $preset_opt && -n ${AGENT_ROLES_PRESET:-} ]]; then
  if pinned "$role"; then
    echo "agent-role: note: $role keeps its preset $preset (pinned)." \
      "AGENT_ROLES_PRESET is not used." >&2
  else
    preset_opt=$AGENT_ROLES_PRESET
  fi
fi
if [[ -n $preset_opt && $preset_opt != "$preset" ]]; then
  check_pin "$role"
  preset=$preset_opt
fi
model=$(resolve_model "$preset")
tools=$(fm tools | tr -d ' ')
extra=$(jq -r --arg r "$role" '(.extraTools[$r] // []) | join(",")' "$config")
[[ -n $extra ]] && tools=${tools:+$tools,}$extra
where=${where:-$(fm pane)}
where=${where:-right}

load_exts

# One name prefix per tab: the tab id in lower case, with ":" as "-" (wT:t2
# -> wt-t2). Agent names allow only letters, digits, "_" and "-". The hw and
# ht orchestrator uses the same prefix.
prefix=${tab:-w}
prefix=$(printf "%s" "${prefix//:/-}" | tr "[:upper:]" "[:lower:]")
name=${name:-$prefix-$role}

# One prompt file. Task mode: base rules, the orchestrator rules (_task.md), then
# the role. Chat mode: base rules, the role, then the chat rules (_chat.md) last,
# so they override the Reply section of the role. The chat file has its own name:
# a chat and a task agent of one role can run together. The writing style
# applies only to the orchestrator (see hw), so it is not in role prompts.
mkdir -p "$cache"
if ((chat)); then
  [[ -f $roles_dir/_chat.md ]] || die "no chat rules: $roles_dir/_chat.md"
  prompt=$cache/$role.chat.md
  {
    [[ -f $roles_dir/_base.md ]] && { cat "$roles_dir/_base.md"; echo; }
    body
    echo
    cat "$roles_dir/_chat.md"
  } >"$prompt"
else
  prompt=$cache/$role.md
  {
    [[ -f $roles_dir/_base.md ]] && { cat "$roles_dir/_base.md"; echo; }
    [[ -f $roles_dir/_task.md ]] && { cat "$roles_dir/_task.md"; echo; }
    body
  } >"$prompt"
fi

# No -ne here: some Pi installs refuse it. The role agent dir does the same
# job (see the header), with and without such an install.
args=(${exts[@]+"${exts[@]}"} --model "$model" --append-system-prompt "$prompt")
[[ -n $tools ]] && args+=(--tools "$tools")
# agent-role names the session, so it can find the session file later. Pi
# opens the session with this id in the cwd, or makes a new one. A new id
# makes Pi print a warning before it starts: no session has the id yet.
session=${session:-$name-$(date +%Y%m%d%H%M%S)}
[[ $session =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]] ||
  die "a session id has only letters, digits, '.', '_' and '-': $session"
args+=(--session-id "$session")

# Make the role agent dir ready. Run it before each start, so changes in your
# own dir show up in the next role agent.
prepare_agent_dir() {
  local f s=$agent_dir/settings.json u=$user_dir/settings.json cur=/dev/null
  mkdir -p "$agent_dir"
  for f in auth.json models.json keybindings.json trust.json AGENTS.md; do
    if [[ -e $user_dir/$f ]]; then
      # Change a link only when it is wrong: a Pi that starts must not find
      # the file missing.
      [[ $(readlink "$agent_dir/$f" || true) == "$user_dir/$f" ]] ||
        ln -sfn "$user_dir/$f" "$agent_dir/$f"
    elif [[ -L $agent_dir/$f ]]; then
      rm "$agent_dir/$f"
    fi
  done
  # Keep the keys that Pi or the Pi install wrote. Copy some keys from your
  # settings. No packages, and no built-in extensions: the config gives each
  # one that a role agent needs with -e. Hold the lock that Pi uses for this
  # file, so that parallel starts and Pi do not lose a write. Pi holds it for
  # milliseconds. Do not remove a lock that is not ours: stop after 5 s.
  # The EXIT trap uses globals: bash removes the locals before it runs.
  local i
  settings_lock=$s.lock settings_tmp=""
  for i in {1..100}; do
    mkdir "$settings_lock" 2>/dev/null && break
    ((i < 100)) ||
      die "$settings_lock is there for 5 s. If no Pi uses $agent_dir, remove it."
    sleep 0.05
  done
  trap 'rm -f "$settings_tmp"; rmdir "$settings_lock" 2>/dev/null' EXIT
  [[ -s $s ]] && cur=$s
  [[ -s $u ]] || u=/dev/null
  settings_tmp=$(mktemp "$agent_dir/.settings.XXXXXX")
  jq -n --slurpfile cur "$cur" --slurpfile u "$u" '($cur[0] // {})
    + (($u[0] // {}) | {theme, tuiMode, terminal, hideThinkingBlock,
      defaultThinkingLevel} | with_entries(select(.value != null)))
    + {packages: [], extensions: ["-builtin:mcp", "-builtin:codemode",
      "-builtin:tool-search", "-builtin:llama.cpp"]}' >"$settings_tmp"
  mv "$settings_tmp" "$s"
  rmdir "$settings_lock"
  trap - EXIT
}

# Warn when the project can add extensions. A role agent loads them if you
# trust the project, as your own Pi does.
warn_project_extensions() {
  local d top
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
  for d in "$cwd" ${top:+"$top"}; do
    if [[ -d $d/.pi/extensions ]] ||
      jq -e '(.extensions // []) + (.packages // []) | length > 0' \
        "$d/.pi/settings.json" >/dev/null 2>&1; then
      echo "agent-role: note: $d/.pi adds extensions or packages. The role" \
        "agent loads them if you trust that project." >&2
      return
    fi
  done
}

if ((dry)); then
  echo "pane env: PI_CODING_AGENT_DIR=$agent_dir"
  printf '%q ' herdr agent start "$name" --kind pi --pane "<$where>" -- "${args[@]}"
  echo
  exit
fi

[[ ${HERDR_ENV:-} == 1 && -n $self && -n $tab ]] || die "run this inside a herdr pane"
if herdr agent get "$name" >/dev/null 2>&1; then
  die "agent $name exists; use --name, or run: agent-role --stop $name"
fi

prepare_agent_dir
check_model "$model" "$cwd"
# Pi does not record a --model that it gets on resume, so the session can name
# an old model. Only a model change after the lines that are there now is
# newer than the state file.
skip=0
if f=$(session_file "$session") && [[ -n $f ]]; then skip=$(wc -l <"$f" | tr -d ' '); fi
warn_project_extensions

# A new pane gets the role agent dir in its environment.
split() { # pane direction [ratio]
  herdr pane split "$1" --direction "$2" ${3:+--ratio "$3"} --cwd "$cwd" --no-focus \
    --env "PI_CODING_AGENT_DIR=$agent_dir" | jq -er '.result.pane.pane_id'
}

side_panes() {
  herdr pane list --workspace "${tab%%:*}" |
    jq -c --arg t "$tab" '[.result.panes[] | select(.tab_id == $t and
      (.label == "side" or ((.label // "") | startswith("side: "))))]'
}

# Move a pane next to a target pane in this tab. herdr moves panes only between
# tabs, so the pane goes through a temporary tab. herdr closes that tab.
move_next_to() { # pane target direction
  herdr pane move "$1" --new-tab --no-focus >/dev/null
  herdr pane move "$1" --tab "$tab" --target-pane "$2" --split "$3" --no-focus >/dev/null
}

# Make a full-height side column on the right of the tab, and print its pane.
# herdr splits panes, not tabs. So split the top-left pane to the right, then
# move the panes of the lower row under the top-left pane, left to right.
# This fits the hw layout. When the last side pane closes, the layout returns
# to its first shape.
new_side_column() {
  local layout anchor side prev dir p
  layout=$(herdr pane layout --pane "$self")
  anchor=$(jq -r '.result.layout.panes[] | select(.rect.x == 0 and .rect.y == 0) | .pane_id' <<<"$layout")
  side=$(split "$anchor" right 0.6)
  prev=$anchor dir=down
  for p in $(jq -r '[.result.layout.panes[] | select(.rect.y > 0)] | sort_by(.rect.y, .rect.x) | .[].pane_id' <<<"$layout"); do
    move_next_to "$p" "$prev" "$dir"
    prev=$p dir=right
  done
  echo "$side"
}

label_prefix="" new=1
case $where in
  right) pane=$(split "$self" right) ;;
  side)
    sides=$(side_panes)
    # Reuse a side pane whose agent has exited.
    pane=$(jq -r 'map(select(.agent == null)) | .[0].pane_id // empty' <<<"$sides")
    if [[ -n $pane ]]; then
      new=0
    else
      last=$(jq -r '.[-1].pane_id // empty' <<<"$sides")
      if [[ -n $last ]]; then pane=$(split "$last" down); else pane=$(new_side_column); fi
    fi
    label_prefix="side: "
    ;;
  *)
    pane=$where new=0
    label=$(herdr pane list --workspace "${tab%%:*}" |
      jq -r --arg p "$pane" '.result.panes[] | select(.pane_id == $p) | .label // ""')
    case $label in side | "side: "*) label_prefix="side: " ;; esac
    ;;
esac
herdr pane rename "$pane" "$label_prefix$pane · $name" >/dev/null
# herdr cannot set the environment of a pane that is there already. Set the
# role agent dir in its shell. The shell keeps it after the agent exits.
if ((!new)); then
  herdr pane run "$pane" "export PI_CODING_AGENT_DIR=$(printf %q "$agent_dir")" >/dev/null
fi

# Print why the start failed, with the last lines of the pane.
start_failed() {
  echo "agent-role: agent start failed in pane $pane: $1" >&2
  echo "agent-role: last lines of pane $pane:" >&2
  if [[ -s $lines ]]; then cat "$lines" >&2
  else herdr pane read "$pane" --source recent --lines 15 >&2 || true; fi
  exit 1
}

# Start the agent and print the herdr reply. herdr waits until Pi is ready,
# for up to 60 s. In a new pane, watch the pane while herdr waits, and stop
# early when Pi exited. The proof: Pi was in front, and then the shell was in
# front again for 1 s. A process is Pi when its argv has the prompt file of
# this start, or when its name is "pi" (Pi sets its process title). Shell
# hooks match neither. A failed Pi can exit in less than 0.5 s, so look every
# 0.1 s. If Pi is not seen, wait for herdr. After a stop, keep the last lines
# and close the pane: a stopped start stays in herdr until its pane closes.
# In a pane that was there already, always wait for herdr.
fg_job() { # prints: pi, shell, other, or nothing if herdr does not know
  herdr pane process-info --pane "$pane" 2>/dev/null |
    jq -r --arg p "$prompt" '.result.process_info |
      if .foreground_process_group_id == null then empty
      elif .foreground_process_group_id == .shell_pid then "shell"
      elif any(.foreground_processes[]?; .argv0 == "pi" or
        ((.argv // []) | join(" ") | contains($p))) then "pi"
      else "other" end'
}
start_agent() {
  local reply job seen=0 idle=0
  reply=$(mktemp "${TMPDIR:-/tmp}/agent-role-start.XXXXXX")
  herdr agent start "$name" --kind pi --pane "$pane" --timeout 60000 -- "${args[@]}" \
    >"$reply" 2>&1 &
  job=$!
  while ((new)) && kill -0 "$job" 2>/dev/null; do
    sleep 0.1
    case $(fg_job || true) in
      pi) seen=1 idle=0 ;;
      shell) ((seen)) && idle=$((idle + 1)) ;;
      other) idle=0 ;;
    esac
    ((idle >= 10)) || continue
    if [[ $(fg_job || true) == shell ]] && kill -0 "$job" 2>/dev/null; then
      kill "$job" 2>/dev/null || true
      wait "$job" 2>/dev/null || true
      rm -f "$reply"
      herdr pane read "$pane" --source recent --lines 15 >"$lines" 2>&1 || true
      herdr pane close "$pane" >/dev/null 2>&1 || true
      echo "Pi exited before it was ready; the pane is closed"
      return 1
    fi
  done
  local rc=0
  wait "$job" || rc=$?
  cat "$reply"
  rm -f "$reply"
  return "$rc"
}

# A new pane needs a moment before its shell is ready. Retry while herdr
# reports the pane as busy.
lines=$(mktemp "${TMPDIR:-/tmp}/agent-role-lines.XXXXXX")
trap 'rm -f "$lines"' EXIT
for _ in {1..30}; do
  if out=$(start_agent); then
    break
  fi
  [[ $out == *agent_pane_busy* ]] || start_failed "$out"
  sleep 0.5
done
[[ $out != *'"error"'* ]] || start_failed "$out"
# A pane that was given by id is gone after a restart: keep its kind.
case $where in
  right | side) ;;
  *) if [[ -n $label_prefix ]]; then where=side; else where=right; fi ;;
esac
mkdir -p "$meta"
jq -n --arg name "$name" --arg role "$role" --arg preset "$preset" --arg model "$model" \
  --arg pane "$pane" --arg where "$where" --arg cwd "$cwd" --arg session "$session" \
  --arg tab "$tab" --argjson skip "$skip" --argjson chat "$chat" \
  '{$name, $role, $preset, $model, $pane, $where, $cwd, $session, $tab, $skip, chat: ($chat == 1)}' \
  >"$meta/$name.json"
tab_models | warn_families
((!focus)) || herdr agent focus "$name" >/dev/null
jq -n --arg name "$name" --arg role "$role" --arg pane "$pane" --arg preset "$preset" \
  --arg model "$model" '{name: $name, role: $role, pane: $pane, preset: $preset, model: $model}'
